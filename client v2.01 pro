class DashboardHandler(BaseHTTPRequestHandler):
def log_message(self, *args):
pass

def _send_json(self, data, status=200):
body = json.dumps(data, ensure_ascii=False, default=str).encode("utf-8")
self.send_response(status)
self.send_header("Content-Type", "application/json; charset=utf-8")
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
try:
self.wfile.write(body)
except Exception:
pass

def _send_html(self, html, status=200):
body = html.encode("utf-8")
self.send_response(status)
self.send_header("Content-Type", "text/html; charset=utf-8")
self.send_header("Content-Length", str(len(body)))
self.end_headers()
try:
self.wfile.write(body)
except Exception:
pass

def do_GET(self):
p = urllib.parse.urlparse(self.path).path

if p in ("/", "/index.html"):
self._send_html(HTML_DASHBOARD)

elif p == "/api/stats":
self._send_json({
"cache": CACHE.stats(),
"token": SESSION.is_valid(),
"username": SESSION.get_username(),
"api_ok": True,
"version": VERSION,
"timestamp": datetime.now().isoformat(),
})

elif p == "/api/rate":
resp = API.get_rate_limit()
if resp.error:
self._send_json({"error": resp.error}, 500)
else:
self._send_json(resp.data)

elif p == "/api/cache":
self._send_json(CACHE.stats())

elif p == "/api/logs":
lines = []
try:
if LOG_FILE.exists():
content = LOG_FILE.read_text(encoding="utf-8")
lines = content.strip().split("\n")[-30:]
except Exception:
pass
self._send_json({"lines": lines})

elif p == "/api/whoami":
if SESSION.is_valid():
self._send_json({"logged_in": True,
"username": SESSION.get_username()})
else:
self._send_json({"logged_in": False})

elif p == "/api/version":
self._send_json({
"version": VERSION, "auteur": AUTEUR,
"protocole": PROTOCOLE, "licence": LICENCE
})

else:
self._send_json({"error": "not found", "path": p}, 404)

def do_POST(self):
p = urllib.parse.urlparse(self.path).path

if p == "/api/action":
length = int(self.headers.get("Content-Length", 0))
body = self.rfile.read(length).decode("utf-8") if length else "{}"

try:
data = json.loads(body)
except json.JSONDecodeError:
self._send_json({"error": "JSON invalide"}, 400)
return

action = data.get("action")

if action == "user":
username = data.get("username")
resp = API.get_user(username)
self._send_json(resp.data if not resp.error else {"error": resp.error})

elif action == "repo":
owner = data.get("owner")
name = data.get("name")
resp = API.get_repo(owner, name)
self._send_json(resp.data if not resp.error else {"error": resp.error})

elif action == "search":
query = data.get("query")
t = data.get("type", "repos")
if t == "users":
resp = API.search_users(query)
elif t == "code":
resp = API.search_code(query)
else:
resp = API.search_repos(query)
self._send_json(resp.data if not resp.error else {"error": resp.error})

elif action == "trending":
lang = data.get("language")
resp = API.get_trending(language=lang)
self._send_json(resp.data if not resp.error else {"error": resp.error})

elif action == "rate":
resp = API.get_rate_limit()
self._send_json(resp.data if not resp.error else {"error": resp.error})

elif action == "cache":
self._send_json(CACHE.stats())

elif action == "whoami":
if SESSION.is_valid():
self._send_json({"logged_in": True,
"username": SESSION.get_username()})
else:
self._send_json({"logged_in": False})

elif action == "clearcache":
CACHE.clear()
self._send_json({"status": "cache vidé"})

else:
self._send_json({"error": f"action inconnue : {action}"}, 400)

else:
self._send_json({"error": "not found"}, 404)


class DashboardServer(ThreadingHTTPServer):
daemon_threads = True
allow_reuse_address = True


def lancer_dashboard(port=8080):
LOG.info(f"Dashboard : http://127.0.0.1:{port}/")
try:
server = DashboardServer(("0.0.0.0", port), DashboardHandler)
server.serve_forever()
except KeyboardInterrupt:
LOG.info("Dashboard arrêté")
except OSError as e:
LOG.error(f"Port {port} : {e}")


