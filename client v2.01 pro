class Logger:
"""Logger avec bannière Nexus."""

def __init__(self, log_file):
self.log_file = log_file
self.level = "INFO"
self._rotation()

def _rotation(self):
try:
if self.log_file.exists() and self.log_file.stat().st_size > 5 * 1024 * 1024:
backup = self.log_file.with_suffix(".log.old")
if backup.exists():
backup.unlink()
self.log_file.rename(backup)
except Exception:
pass

def _write(self, niveau, msg):
ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
line = f"[{ts}] [{niveau:5s}] {msg}"

try:
with open(self.log_file, "a", encoding="utf-8") as f:
f.write(line + "\n")
except Exception:
pass

# Console
colors = {
"OK": COLORS["green"],
"INFO": COLORS["gh-accent-hover"],
"WARN": COLORS["yellow"],
"ERR": COLORS["red"],
"DEBUG": COLORS["dim"],
}
prefix_map = {
"OK": "✓",
"INFO": "ℹ",
"WARN": "⚠",
"ERR": "✗",
"DEBUG": "·",
}
c = colors.get(niveau, "")
p = prefix_map.get(niveau, "")
r = COLORS["reset"]

if niveau == "DEBUG" and self.level != "DEBUG":
return

print(f"{c}{p}{r} {msg}")

def debug(self, msg): self._write("DEBUG", msg)
def info(self, msg): self._write("INFO", msg)
def ok(self, msg): self._write("OK", msg)
def warn(self, msg): self._write("WARN", msg)
def error(self, msg): self._write("ERR", msg)

