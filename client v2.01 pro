document.getElementById('cache-entries').textContent = d.cache.entries;
document.getElementById('cache-size').textContent =
(d.cache.size_bytes / 1024).toFixed(1) + ' KB';
document.getElementById('token-status').textContent = d.token ? '✓' : '✗';
document.getElementById('api-status').textContent = d.api_ok ? '✓' : '✗';

const dot = document.getElementById('auth-dot');
const status = document.getElementById('auth-status');
const userDisplay = document.getElementById('auth-user-display');

if (d.token) {
dot.classList.remove('offline');
status.textContent = 'Connecté';
status.style.color = 'var(--gh-success)';
userDisplay.textContent = d.username || 'Anonyme';
userDisplay.style.color = 'var(--nx-or)';
} else {
dot.classList.add('offline');
status.textContent = 'Non connecté';
status.style.color = 'var(--gh-danger)';
userDisplay.textContent = 'Mode public (60 req/h)';
userDisplay.style.color = 'var(--gh-muted)';
}
} catch(e) {
console.error(e);
}
}

// ============================================================================
// RATE LIMITS
// ============================================================================
async function loadRates(){
try {
const d = await fetchJSON('/api/rate');
const div = document.getElementById('rate-limits');
div.innerHTML = '';

if (d.resources) {
for (const [name, info] of Object.entries(d.resources)) {
const pct = info.limit ? (info.remaining / info.limit * 100) : 0;
const cls = pct > 50 ? '' : (pct > 20 ? 'warn' : 'danger');
div.innerHTML += `
<div class="rate-item">
<span class="rate-label">${name}</span>
<div class="rate-bar">
<div class="rate-fill ${cls}" style="width:${pct}%"></div>
</div>
<span class="rate-count">${info.remaining}/${info.limit}</span>
</div>`;
}
} else {
div.textContent = d.error || 'Non disponible';
}
} catch(e) {
console.error(e);
}
}

// ============================================================================
// LOGS
// ============================================================================
async function loadLogs(){
try {
const d = await fetchJSON('/api/logs');
const box = document.getElementById('log-box');
box.innerHTML = '';
(d.lines || []).forEach(line => {
let cls = 'log-info';
if (line.includes('[OK]')) cls = 'log-ok';
else if (line.includes('[WARN]')) cls = 'log-warn';
else if (line.includes('[ERR]')) cls = 'log-err';
box.innerHTML += `<div class="log-line"><span class="${cls}">${escapeHtml(line)}</span></div>`;
});
box.scrollTop = box.scrollHeight;
} catch(e) {
console.error(e);
}
}

function escapeHtml(s){
