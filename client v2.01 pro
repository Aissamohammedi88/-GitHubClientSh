"html_url": data.get("html_url"),
"homepage": data.get("homepage"),
"has_issues": data.get("has_issues", False),
"has_wiki": data.get("has_wiki", False),
"has_pages": data.get("has_pages", False),
}

@staticmethod
def rank_repos(repos, by="stars"):
if not repos:
return []
key_map = {
"stars": lambda r: r.get("stargazers_count", 0),
"forks": lambda r: r.get("forks_count", 0),
"issues": lambda r: r.get("open_issues_count", 0),
"updated": lambda r: r.get("updated_at", ""),
"created": lambda r: r.get("created_at", ""),
}
key = key_map.get(by, key_map["stars"])
return sorted(repos, key=key, reverse=True)

@staticmethod
def detect_languages(repos):
counter = Counter()
for r in repos:
lang = r.get("language")
if lang:
counter[lang] += 1
return counter.most_common(20)

@staticmethod
def health_score(repo):
score = 0
pushed = repo.get("pushed_at")
if pushed:
try:
d = datetime.fromisoformat(pushed.replace("Z", "+00:00"))
days = (datetime.now(timezone.utc) - d).days
if days < 7: score += 30
elif days < 30: score += 25
elif days < 90: score += 15
elif days < 365: score += 5
except Exception:
pass
if repo.get("license"): score += 10
if repo.get("description"): score += 10
if repo.get("has_wiki") or repo.get("has_pages"): score += 10
oi = repo.get("open_issues_count", 0)
if oi < 10: score += 10
elif oi < 50: score += 5
stars = repo.get("stargazers_count", 0)
if stars > 1000: score += 20
elif stars > 100: score += 15
elif stars > 10: score += 10
elif stars > 0: score += 5
if repo.get("forks_count", 0) > 10: score += 10
elif repo.get("forks_count", 0) > 0: score += 5
return min(score, 100)


