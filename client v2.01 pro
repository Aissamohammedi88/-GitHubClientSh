class Formatter:
@staticmethod
def table(headers, rows, max_width=30):
if not rows:
return " (aucune donnée)"
widths = [len(str(h)) for h in headers]
for row in rows:
for i, cell in enumerate(row):
if i < len(widths):
widths[i] = min(max(widths[i], len(str(cell))), max_width)
sep = "+" + "+".join("-" * (w + 2) for w in widths) + "+"
out = [sep]
header_line = "|"
for i, h in enumerate(headers):
header_line += f" {str(h)[:widths[i]].ljust(widths[i])} |"
out.append(header_line)
out.append(sep)
for row in rows:
line = "|"
for i, cell in enumerate(row):
if i < len(widths):
s = str(cell)[:widths[i]].ljust(widths[i])
line += f" {s} |"
out.append(line)
out.append(sep)
return "\n".join(out)

@staticmethod
def json_output(data, pretty=True):
return json.dumps(data, indent=2 if pretty else None,
ensure_ascii=False, default=str)

@staticmethod
def human_number(n):
if n is None:
return "N/A"
try:
n = int(n)
except (ValueError, TypeError):
return str(n)
if n < 1000:
return str(n)
if n < 1_000_000:
return f"{n/1000:.1f}k"
if n < 1_000_000_000:
return f"{n/1_000_000:.1f}M"
return f"{n/1_000_000_000:.1f}B"

@staticmethod
def human_date(iso_date):
if not iso_date:
return "N/A"
try:
d = datetime.fromisoformat(iso_date.replace("Z", "+00:00"))
now = datetime.now(timezone.utc)
delta = now - d
if delta.days > 365:
return f"il y a {delta.days // 365} an(s)"
if delta.days > 30:
return f"il y a {delta.days // 30} mois"
if delta.days > 0:
return f"il y a {delta.days} j"
if delta.seconds > 3600:
return f"il y a {delta.seconds // 3600} h"
if delta.seconds > 60:
return f"il y a {delta.seconds // 60} min"
return "à l'instant"
except Exception:
return iso_date

@staticmethod
def bytes_human(n):
for unit in ["B", "KB", "MB", "GB", "TB"]:
if n < 1024:
return f"{n:.1f} {unit}"
n /= 1024
return f"{n:.1f} PB"


