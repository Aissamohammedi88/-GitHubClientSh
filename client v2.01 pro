def build_parser():
parser = argparse.ArgumentParser(
prog="github_client",
description=f"Nexus GitHub Client v{VERSION}"
)
parser.add_argument("--version", action="version",
version=f"%(prog)s {VERSION}")
parser.add_argument("--token", help="GitHub token (bypass OAuth)")
parser.add_argument("--json", action="store_true")
parser.add_argument("--verbose", "-v", action="store_true")
parser.add_argument("--clear-cache", action="store_true")

sub = parser.add_subparsers(dest="command")

sub.add_parser("login", help="Se connecter via OAuth")
sub.add_parser("logout", help="Se déconnecter")
sub.add_parser("whoami", help="Utilisateur connecté")

p_user = sub.add_parser("user", help="Infos utilisateur")
p_user.add_argument("username")

p_repos = sub.add_parser("repos", help="Repos d'un utilisateur")
p_repos.add_argument("username")
p_repos.add_argument("--limit", type=int, default=30)
p_repos.add_argument("--sort", default="stars",
choices=["stars", "forks", "issues", "updated", "created"])

p_repo = sub.add_parser("repo", help="Analyse un repo")
p_repo.add_argument("target")

p_search = sub.add_parser("search", help="Recherche")
p_search.add_argument("query")
p_search.add_argument("--type", default="repos",
choices=["repos", "users", "code", "issues"])
p_search.add_argument("--limit", type=int, default=20)

p_tr = sub.add_parser("trending", help="Trending")
p_tr.add_argument("--language")

sub.add_parser("rate", help="Rate limit")

p_cache = sub.add_parser("cache", help="Cache")
p_cache.add_argument("--clear", action="store_true")

p_cmp = sub.add_parser("compare", help="Comparer 2 users")
p_cmp.add_argument("user1")
p_cmp.add_argument("user2")

p_act = sub.add_parser("activity", help="Activité user")
p_act.add_argument("username")

p_exp = sub.add_parser("export", help="Export")
p_exp.add_argument("target")

p_web = sub.add_parser("web", help="Dashboard web")
p_web.add_argument("--port", type=int, default=8080)

sub.add_parser("menu", help="Menu interactif")

return parser


# ============================================================================
# SECTION 15 — MAIN
# ============================================================================

def main():
parser = build_parser()
args = parser.parse_args()

if args.token:
CONFIG.set("token", args.token)
API.token = args.token

if args.clear_cache:
CACHE.clear()
LOG.ok("Cache vidé")

if not args.command:
LOG.banner()
menu_interactif()
return

try:
if args.command == "login":
CMD.cmd_login(args)
elif args.command == "logout":
CMD.cmd_logout(args)
elif args.command == "whoami":
CMD.cmd_whoami(args)
elif args.command == "user":
CMD.cmd_user(args.username, args)
elif args.command == "repos":
CMD.cmd_repos(args.username, args)
elif args.command == "repo":
if "/" not in args.target:
LOG.error("Format : owner/repo")
return
o, n = args.target.split("/", 1)
CMD.cmd_repo(o, n, args)
elif args.command == "search":
CMD.cmd_search(args.query, args)
elif args.command == "trending":
CMD.cmd_trending(args)
elif args.command == "rate":
CMD.cmd_rate(args)
elif args.command == "cache":
CMD.cmd_cache(args)
elif args.command == "compare":
CMD.cmd_compare(args.user1, args.user2, args)
elif args.command == "activity":
CMD.cmd_activity(args.username, args)
elif args.command == "export":
CMD.cmd_export(args)
elif args.command == "web":
lancer_dashboard(args.port)
elif args.command == "menu":
LOG.banner()
menu_interactif()
except KeyboardInterrupt:
print("")
LOG.info("Interrompu")
except Exception as e:
LOG.error(f"Erreur : {e}")
if args.verbose:
import traceback
traceback.print_exc()


if __name__ == "__main__":
main()
