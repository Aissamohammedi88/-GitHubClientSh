class OAuthDeviceFlow:
"""Implémentation du GitHub Device Flow OAuth."""

def __init__(self, client_id=OAUTH_CLIENT_ID, scope=OAUTH_SCOPE):
self.client_id = client_id
self.scope = scope

def start(self):
"""Démarre le device flow."""
LOG.info("Démarrage OAuth Device Flow...")

data = urllib.parse.urlencode({
"client_id": self.client_id,
"scope": self.scope,
}).encode("utf-8")

req = urllib.request.Request(
API_OAUTH_DEVICE,
data=data,
headers={
"Accept": "application/json",
"User-Agent": CONFIG.get("user_agent"),
},
method="POST",
)

try:
with urllib.request.urlopen(req, timeout=TIMEOUT_DEFAULT) as resp:
result = json.loads(resp.read().decode("utf-8"))
return result
except Exception as e:
LOG.error(f"Erreur OAuth start : {e}")
return None

def poll_token(self, device_code, interval=5, timeout=600):
"""Poll le token jusqu'à validation."""
LOG.info("En attente de validation sur GitHub...")

start_time = time.time()
interval = max(interval, 5)

while time.time() - start_time < timeout:
time.sleep(interval)

data = urllib.parse.urlencode({
"client_id": self.client_id,
"device_code": device_code,
"grant_type": "urn:ietf:params:oauth:grant-type:device_code",
}).encode("utf-8")

req = urllib.request.Request(
API_OAUTH_TOKEN,
data=data,
headers={
"Accept": "application/json",
"User-Agent": CONFIG.get("user_agent"),
},
method="POST",
)

try:
with urllib.request.urlopen(req, timeout=TIMEOUT_DEFAULT) as resp:
result = json.loads(resp.read().decode("utf-8"))

if "access_token" in result:
LOG.ok("Token obtenu !")
return result["access_token"]

error = result.get("error")
if error == "authorization_pending":
print(f" {COLORS['dim']}En attente...{COLORS['reset']}", end="\r")
continue
elif error == "slow_down":
interval += 5
continue
elif error == "expired_token":
LOG.error("Code expiré")
return None
elif error == "access_denied":
LOG.error("Accès refusé par l'utilisateur")
return None
else:
LOG.error(f"Erreur : {error}")
return None

except Exception as e:
LOG.error(f"Polling : {e}")
return None

LOG.error("Timeout OAuth")
return None

