class Cache:
def __init__(self, db_path):
self.db_path = db_path
self._init_db()

def _init_db(self):
conn = sqlite3.connect(self.db_path, check_same_thread=False)
conn.execute("PRAGMA journal_mode=WAL")
conn.execute("PRAGMA synchronous=NORMAL")
conn.execute("""
CREATE TABLE IF NOT EXISTS cache (
key TEXT PRIMARY KEY,
value TEXT NOT NULL,
ts INTEGER NOT NULL,
ttl INTEGER NOT NULL,
endpoint TEXT
)
""")
conn.execute("""
CREATE TABLE IF NOT EXISTS rate_limit (
id INTEGER PRIMARY KEY AUTOINCREMENT,
ts INTEGER NOT NULL,
endpoint TEXT,
remaining INTEGER,
limit_total INTEGER,
reset_at INTEGER
)
""")
conn.execute("""
CREATE TABLE IF NOT EXISTS history (
id INTEGER PRIMARY KEY AUTOINCREMENT,
ts INTEGER NOT NULL,
command TEXT,
args TEXT,
result TEXT
)
""")
conn.execute("CREATE INDEX IF NOT EXISTS idx_cache_ts ON cache(ts)")
conn.execute("CREATE INDEX IF NOT EXISTS idx_history_ts ON history(ts)")
conn.commit()
conn.close()

def _conn(self):
conn = sqlite3.connect(self.db_path, check_same_thread=False)
conn.row_factory = sqlite3.Row
return conn

def _key(self, endpoint, params=None):
s = endpoint
if params:
s += "|" + json.dumps(params, sort_keys=True)
return hashlib.sha256(s.encode()).hexdigest()

def get(self, endpoint, params=None):
if not CONFIG.get("cache_enabled"):
return None
key = self._key(endpoint, params)
conn = self._conn()
row = conn.execute(
"SELECT value, ts, ttl FROM cache WHERE key=?",
(key,)
).fetchone()
conn.close()

if row:
age = time.time() - row["ts"]
if age < row["ttl"]:
try:
return json.loads(row["value"])
except Exception:
return None
return None

def set(self, endpoint, params, value, ttl=3600):
if not CONFIG.get("cache_enabled"):
return
key = self._key(endpoint, params)
conn = self._conn()
try:
conn.execute(
"INSERT OR REPLACE INTO cache (key, value, ts, ttl, endpoint) VALUES (?,?,?,?,?)",
(key, json.dumps(value, ensure_ascii=False), int(time.time()), ttl, endpoint)
)
conn.commit()
except Exception as e:
LOG.warn(f"Cache set : {e}")
conn.close()

def clear(self, older_than_days=None):
conn = self._conn()
if older_than_days:
cutoff = int(time.time()) - (older_than_days * 86400)
conn.execute("DELETE FROM cache WHERE ts < ?", (cutoff,))
else:
conn.execute("DELETE FROM cache")
conn.commit()
conn.close()

def stats(self):
conn = self._conn()
rows = conn.execute("SELECT COUNT(*) as n FROM cache").fetchone()
size = self.db_path.stat().st_size if self.db_path.exists() else 0
conn.close()
return {"entries": rows["n"], "size_bytes": size}

def log_rate_limit(self, endpoint, remaining, limit_total, reset_at):
conn = self._conn()
conn.execute(
"INSERT INTO rate_limit (ts, endpoint, remaining, limit_total, reset_at) VALUES (?,?,?,?,?)",
(int(time.time()), endpoint, remaining, limit_total, reset_at)
)
conn.commit()
conn.close()

def log_history(self, command, args, result):
conn = self._conn()
conn.execute(
"INSERT INTO history (ts, command, args, result) VALUES (?,?,?,?)",
(int(time.time()), command, json.dumps(args), json.dumps(result)[:5000])
)
conn.commit()
conn.close()


