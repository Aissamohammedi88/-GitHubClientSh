<script>
async function fetchJSON(url, opts){
const r = await fetch(url, opts);
return r.json();
}
async function loadStats(){
try{
const d = await fetchJSON('/api/stats');
document.getElementById('cache-n').textContent = d.cache.entries;
document.getElementById('cache-size').textContent =
(d.cache.size_bytes / 1024).toFixed(1) + ' KB';
document.getElementById('token-status').textContent = d.token ? 'OK' : 'NON';
document.getElementById('api-status').textContent = d.api_ok ? 'OK' : 'KO';
}catch(e){console.error(e);}
}
async function loadRates(){
try{
const d = await fetchJSON('/api/rate');
const div = document.getElementById('rate-limits');
div.innerHTML = '';
if(d.resources){
for(const [name, info] of Object.entries(d.resources)){
const pct = info.limit ? (info.remaining / info.limit * 100) : 0;
const cls = pct > 50 ? '' : (pct > 20 ? 'warn' : 'danger');
div.innerHTML += `
<div class="rate">
<span style="width:140px">${name}</span>
<div class="bar">
<div class="bar-fill ${cls}" style="width:${pct}%"></div>
</div>
<span>${info.remaining}/${info.limit}</span>
</div>`;
}
} else {
div.textContent = d.error || 'Non disponible';
}
}catch(e){console.error(e);}
}
async function runCmd(){
const cmd = document.getElementById('cmd').value;
const out = document.getElementById('output');
out.textContent = 'Exécution...';
try {
const d = await fetchJSON('/api/action', {
method: 'POST',
headers: {'Content-Type':'application/json'},
body: cmd
});
out.textContent = JSON.stringify(d, null, 2);
loadStats();
}catch(e){
out.textContent = 'Erreur : ' + e.message;
}
}
loadStats();
loadRates();
setInterval(loadStats, 5000);
setInterval(loadRates, 15000);
</script>
</body>
