@dataclass
class APIResponse:
"""Réponse API standardisée."""
status: int
data: Any
error: Optional[str] = None
rate_remaining: Optional[int] = None
rate_limit: Optional[int] = None
rate_reset: Optional[int] = None
from_cache: bool = False
duration_ms: float = 0


class GitHubAPI:
"""Client API GitHub REST + GraphQL."""

def __init__(self, token=None):
self.token = token or CONFIG.get("token", "")
self.user_agent = CONFIG.get("user_agent")
self.timeout = CONFIG.get("timeout", 15)
self._rate_info = {}

def _headers(self):
h = {
"User-Agent": self.user_agent,
"Accept": "application/vnd.github.v3+json",
}
if self.token:
h["Authorization"] = f"Bearer {self.token}"
return h

def _headers_graphql(self):
h = {
"User-Agent": self.user_agent,
"Content-Type": "application/json",
}
if self.token:
h["Authorization"] = f"Bearer {self.token}"
return h

def _request(self, method, url, data=None, params=None, ttl=3600, cache_key=None):
# Cache lookup
endpoint = url
if params:
endpoint += "?" + urllib.parse.urlencode(params, doseq=True)

if method == "GET":
cached = CACHE.get(endpoint)
if cached is not None:
return APIResponse(
status=200, data=cached, from_cache=True, duration_ms=0
)

# Build request
if params:
url += "?" + urllib.parse.urlencode(params, doseq=True)

body = None
if data is not None:
body = json.dumps(data).encode("utf-8")

req = urllib.request.Request(
url,
data=body,
headers=self._headers(),
method=method,
)

start = time.time()
try:
with urllib.request.urlopen(req, timeout=self.timeout) as resp:
duration = (time.time() - start) * 1000
raw = resp.read().decode("utf-8")

# Headers rate limit
remaining = resp.headers.get("X-RateLimit-Remaining")
limit_total = resp.headers.get("X-RateLimit-Limit")
reset = resp.headers.get("X-RateLimit-Reset")

# Parse JSON
try:
data = json.loads(raw) if raw else {}
except json.JSONDecodeError:
data = raw

result = APIResponse(
status=resp.status,
data=data,
rate_remaining=int(remaining) if remaining else None,
rate_limit=int(limit_total) if limit_total else None,
rate_reset=int(reset) if reset else None,
duration_ms=duration,
)

# Cache
if method == "GET" and resp.status == 200:
CACHE.set(endpoint, None, data, ttl)
if remaining:
CACHE.log_rate_limit(endpoint, int(remaining),
int(limit_total) if limit_total else 0,
int(reset) if reset else 0)

return result

except urllib.error.HTTPError as e:
duration = (time.time() - start) * 1000
error_body = ""
try:
error_body = e.read().decode("utf-8")
except Exception:
pass

remaining = e.headers.get("X-RateLimit-Remaining")
limit_total = e.headers.get("X-RateLimit-Limit")
reset = e.headers.get("X-RateLimit-Reset")

msg = f"HTTP {e.code}"
if e.code == 401:
msg += " — Token invalide ou expiré"
elif e.code == 403:
msg += " — Rate limit dépassé ou accès refusé"
elif e.code == 404:
msg += " — Ressource introuvable"
elif e.code == 422:
msg += " — Entité non traitable"

return APIResponse(
status=e.code,
data=error_body,
error=msg,
rate_remaining=int(remaining) if remaining else None,
rate_limit=int(limit_total) if limit_total else None,
rate_reset=int(reset) if reset else None,
duration_ms=duration,
)

except urllib.error.URLError as e:
duration = (time.time() - start) * 1000
return APIResponse(
status=0,
data=None,
error=f"Erreur réseau : {e.reason}",
duration_ms=duration,
)

except Exception as e:
duration = (time.time() - start) * 1000
return APIResponse(
status=0,
data=None,
error=f"Erreur : {e}",
duration_ms=duration,
)

