@staticmethod
def rank_repos(repos, by="stars"):
"""Classe les repos."""
if not repos:
return []
key_map = {
"stars": lambda r: r.get("stargazers_count", 0),
"forks": lambda r: r.get("forks_count", 0),
"issues": lambda r: r.get("open_issues_count", 0),
"updated": lambda r: r.get("updated_at", ""),
"created": lambda r: r.get("created_at", ""),
}
key = key_map.get(by, key_map["stars"])
return sorted(repos, key=key, reverse=True)

@staticmethod
def detect_languages(repos):
"""Détecte les langages dominants."""
counter = Counter()
for r in repos:
lang = r.get("language")
if lang:
counter[lang] += 1
return counter.most_common(20)

@staticmethod
def analyze_activity(repos):
"""Analyse l'activité sur les repos."""
now = datetime.now(timezone.utc)
actifs_30j = 0
actifs_90j = 0
actifs_365j = 0
inactifs = 0

for r in repos:
pushed = r.get("pushed_at") or r.get("updated_at")
if not pushed:
inactifs += 1
continue
try:
d = datetime.fromisoformat(pushed.replace("Z", "+00:00"))
days = (now - d).days
if days < 30:
actifs_30j += 1
elif days < 90:
actifs_90j += 1
elif days < 365:
actifs_365j += 1
else:
inactifs += 1
except Exception:
inactifs += 1

return {
"actifs_30j": actifs_30j,
"actifs_90j": actifs_90j,
"actifs_365j": actifs_365j,
"inactifs": inactifs,
"total": len(repos),
}

@staticmethod
def recommend_similar(target_repo, candidates):
"""Recommande des repos similaires."""
target_lang = target_repo.get("language")
target_topics = set(target_repo.get("topics", []))

scores = []
for c in candidates:
if c.get("full_name") == target_repo.get("full_name"):
continue
score = 0
if c.get("language") == target_lang:
score += 40
topics = set(c.get("topics", []))
common = target_topics & topics
score += len(common) * 10
# Stars weight
stars = c.get("stargazers_count", 0)
if stars > 100:
score += 5
if stars > 1000:
score += 10
scores.append((score, c))

scores.sort(key=lambda x: -x[0])
return [c for _, c in scores[:10]]

@staticmethod
def health_score(repo):
"""Score de santé d'un repo 0-100."""
score = 0

# Activité récente (30 pts)
pushed = repo.get("pushed_at")
if pushed:
try:
d = datetime.fromisoformat(pushed.replace("Z", "+00:00"))
days = (datetime.now(timezone.utc) - d).days
if days < 7:
score += 30
elif days < 30:
score += 25
elif days < 90:
score += 15
elif days < 365:
score += 5
except Exception:
pass

# Licence (10 pts)
if repo.get("license"):
score += 10

# Description (10 pts)
if repo.get("description"):
score += 10

# README (approx via has_wiki/pages) (10 pts)
if repo.get("has_wiki") or repo.get("has_pages"):
score += 10

# Issues gérées (10 pts)
open_issues = repo.get("open_issues_count", 0)
if open_issues < 10:
score += 10
elif open_issues < 50:
score += 5

# Stars (20 pts)
stars = repo.get("stargazers_count", 0)
if stars > 1000:
score += 20
elif stars > 100:
score += 15
elif stars > 10:
score += 10
elif stars > 0:
score += 5

# Forks (10 pts)
if repo.get("forks_count", 0) > 10:
score += 10
elif repo.get("forks_count", 0) > 0:
score += 5

return min(score, 100)


