def build_parser():
parser = argparse.ArgumentParser(
prog="github_client",
description=f"GitHub Client Intelligent v{VERSION}",
formatter_class=argparse.RawDescriptionHelpFormatter,
epilog="""
Exemples :
github_client.py user torvalds
github_client.py repos torvalds --limit 20
github_client.py repo torvalds/linux
github_client.py search "python async" --type repos
github_client.py trending --language rust
github_client.py rate
github_client.py cache --clear
github_client.py compare torvalds gvanrossum
github_client.py recommend torvalds/linux
github_client.py web --port 8080
"""
)

parser.add_argument("--version", action="version",
version=f"%(prog)s {VERSION}")
parser.add_argument("--token", help="GitHub Personal Access Token")
parser.add_argument("--json", action="store_true",
help="Sortie JSON")
parser.add_argument("--clear-cache", action="store_true",
help="Vider le cache avant")
parser.add_argument("--verbose", "-v", action="store_true",
help="Mode verbeux")

subparsers = parser.add_subparsers(dest="command")

# user
p_user = subparsers.add_parser("user", help="Infos utilisateur")
p_user.add_argument("username")

# repos
p_repos = subparsers.add_parser("repos", help="Repos d'un utilisateur")
p_repos.add_argument("username")
p_repos.add_argument("--limit", type=int, default=30)
p_repos.add_argument("--sort", default="stars",
choices=["stars", "forks", "issues", "updated", "created"])

# repo
p_repo = subparsers.add_parser("repo", help="Analyse un repo")
p_repo.add_argument("target", help="owner/repo")

# search
p_search = subparsers.add_parser("search", help="Recherche GitHub")
p_search.add_argument("query")
p_search.add_argument("--type", default="repos",
choices=["repos", "users", "code", "issues"])
p_search.add_argument("--limit", type=int, default=20)

# trending
p_trending = subparsers.add_parser("trending", help="Repos trending")
p_trending.add_argument("--language")

# rate
subparsers.add_parser("rate", help="Rate limit")

# cache
p_cache = subparsers.add_parser("cache", help="Gestion cache")
p_cache.add_argument("--clear", action="store_true")

# compare
p_compare = subparsers.add_parser("compare", help="Comparer 2 users")
p_compare.add_argument("user1")
p_compare.add_argument("user2")

# recommend
p_reco = subparsers.add_parser("recommend", help="Recommandations")
p_reco.add_argument("target", help="owner/repo")

# activity
p_activity = subparsers.add_parser("activity", help="Activité utilisateur")
p_activity.add_argument("username")

# export
p_export = subparsers.add_parser("export", help="Export rapport")
p_export.add_argument("target", help="user ou owner/repo")

# web
p_web = subparsers.add_parser("web", help="Dashboard web")
p_web.add_argument("--port", type=int, default=8080)

# menu
subparsers.add_parser("menu", help="Menu interactif")

return parser


