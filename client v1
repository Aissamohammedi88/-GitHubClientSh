@staticmethod
def analyze_user(data):
"""Analyse complète d'un utilisateur."""
if not data or not isinstance(data, dict):
return None

result = {
"login": data.get("login"),
"name": data.get("name") or data.get("login"),
"bio": data.get("bio"),
"company": data.get("company"),
"location": data.get("location"),
"blog": data.get("blog"),
"email": data.get("email"),
"twitter": data.get("twitter_username"),
"public_repos": data.get("public_repos", 0),
"public_gists": data.get("public_gists", 0),
"followers": data.get("followers", 0),
"following": data.get("following", 0),
"created_at": data.get("created_at"),
"updated_at": data.get("updated_at"),
"avatar_url": data.get("avatar_url"),
"html_url": data.get("html_url"),
"hireable": data.get("hireable"),
"type": data.get("type"),
}

# Score d'influence
result["influence_score"] = Analyzer._influence_score(result)
result["activity_level"] = Analyzer._activity_level(result)

return result

@staticmethod
def _influence_score(user):
"""Score d'influence 0-100."""
followers = user.get("followers", 0)
repos = user.get("public_repos", 0)
gists = user.get("public_gists", 0)

# Log scale
f_score = min(50, math.log10(max(followers, 1)) * 15)
r_score = min(30, math.log10(max(repos, 1)) * 12)
g_score = min(20, math.log10(max(gists, 1)) * 8)

return round(f_score + r_score + g_score, 1)

@staticmethod
def _activity_level(user):
"""Niveau d'activité."""
if not user.get("updated_at"):
return "inconnu"
try:
d = datetime.fromisoformat(user["updated_at"].replace("Z", "+00:00"))
days = (datetime.now(timezone.utc) - d).days
if days < 7:
return "très actif"
if days < 30:
return "actif"
if days < 90:
return "modéré"
if days < 365:
return "peu actif"
return "inactif"
except Exception:
return "inconnu"

