def main():
parser = build_parser()
args = parser.parse_args()

# Token
if args.token:
CONFIG.set("token", args.token)
API.token = args.token

# Clear cache
if args.clear_cache:
CACHE.clear()
LOG.ok("Cache vidé")

# Menu par défaut
if not args.command:
print(f"""
{COLORS['bold']}{COLORS['or']} ══════════════════════════════════════════════════════════════
GITHUB CLIENT INTELLIGENT v{VERSION}
{AUTEUR} · {LICENCE}
══════════════════════════════════════════════════════════════{COLORS['reset']}
""")
menu_interactif()
return

# Dispatch commandes
try:
if args.command == "user":
CMD.cmd_user(args.username, args)

elif args.command == "repos":
CMD.cmd_repos(args.username, args)

elif args.command == "repo":
if "/" not in args.target:
LOG.error("Format : owner/repo")
return
owner, name = args.target.split("/", 1)
CMD.cmd_repo(owner, name, args)

elif args.command == "search":
CMD.cmd_search(args.query, args)

elif args.command == "trending":
CMD.cmd_trending(args)

elif args.command == "rate":
CMD.cmd_rate(args)

elif args.command == "cache":
CMD.cmd_cache(args)

elif args.command == "compare":
CMD.cmd_compare(args.user1, args.user2, args)

elif args.command == "recommend":
if "/" not in args.target:
LOG.error("Format : owner/repo")
return
owner, name = args.target.split("/", 1)
CMD.cmd_recommend(owner, name, args)

elif args.command == "activity":
CMD.cmd_activity(args.username, args)

elif args.command == "export":
CMD.cmd_export(args)

elif args.command == "web":
lancer_dashboard(args.port)

elif args.command == "menu":
menu_interactif()

except KeyboardInterrupt:
print("")
LOG.info("Interrompu par l'utilisateur")

except Exception as e:
LOG.error(f"Erreur : {e}")
if args.verbose:
import traceback
traceback.print_exc()


if __name__ == "__main__":
main()
