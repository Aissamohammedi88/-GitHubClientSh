class DashboardHandler(BaseHTTPRequestHandler):
"""Handler HTTP pour le dashboard."""

def log_message(self, *args):
pass

def _send_json(self, data, status=200):
body = json.dumps(data, ensure_ascii=False, default=str).encode("utf-8")
self.send_response(status)
self.send_header("Content-Type", "application/json; charset=utf-8")
self.send_header("Content-Length", str(len(body)))
self.send_header("Access-Control-Allow-Origin", "*")
self.end_headers()
try:
self.wfile.write(body)
except Exception:
pass

def _send_html(self, html, status=200):
body = html.encode("utf-8")
self.send_response(status)
self.send_header("Content-Type", "text/html; charset=utf-8")
self.send_header("Content-Length", str(len(body)))
self.end_headers()
try:
self.wfile.write(body)
except Exception:
pass

def do_GET(self):
p = urllib.parse.urlparse(self.path).path

if p in ("/", "/index.html"):
self._send_html(HTML_DASHBOARD)

elif p == "/api/stats":
cache_stats = CACHE.stats()
self._send_json({
"cache": cache_stats,
"token": bool(CONFIG.get("token")),
"api_ok": True,
"version": VERSION,
"timestamp": datetime.now().isoformat(),
})

elif p == "/api/rate":
resp = API.get_rate_limit()
if resp.error:
self._send_json({"error": resp.error}, 500)
else:
self._send_json(resp.data)

elif p == "/api/cache":
self._send_json(CACHE.stats())

elif p == "/api/version":
self._send_json({
"version": VERSION,
"auteur": AUTEUR,
"licence": LICENCE,
})

else:
self._send_json({"error": "not found", "path": p}, 404)

def do_POST(self):
p = urllib.parse.urlparse(self.path).path

if p == "/api/action":
length = int(self.headers.get("Content-Length", 0))
body = self.rfile.read(length).decode("utf-8") if length else "{}"

try:
data = json.loads(body)
except json.JSONDecodeError:
self._send_json({"error": "JSON invalide"}, 400)
return

action = data.get("action")

if action == "user":
username = data.get("username")
resp = API.get_user(username)
self._send_json(resp.data if not resp.error else {"error": resp.error})

elif action == "repo":
owner = data.get("owner")
name = data.get("name")
resp = API.get_repo(owner, name)
self._send_json(resp.data if not resp.error else {"error": resp.error})

elif action == "search":
query = data.get("query")
type_search = data.get("type", "repos")
if type_search == "repos":
resp = API.search_repos(query)
elif type_search == "users":
resp = API.search_users(query)
else:
resp = API.search_repos(query)
self._send_json(resp.data if not resp.error else {"error": resp.error})

elif action == "trending":
lang = data.get("language")
resp = API.get_trending(language=lang)
self._send_json(resp.data if not resp.error else {"error": resp.error})

elif action == "compare":
u1 = data.get("user1")
u2 = data.get("user2")
r1 = API.get_user(u1)
r2 = API.get_user(u2)
self._send_json({
"user1": r1.data if not r1.error else {"error": r1.error},
"user2": r2.data if not r2.error else {"error": r2.error},
})

elif action == "recommend":
owner = data.get("owner")
name = data.get("name")
r = API.get_repo(owner, name)
if r.error:
self._send_json({"error": r.error})
return
target = ANALYZER.analyze_repo(r.data)
lang = target.get("language")
query = f"language:{lang}" if lang else "stars:>1000"
resp = API.search_repos(query, per_page=30)
self._send_json(resp.data if not resp.error else {"error": resp.error})

elif action == "activity":
username = data.get("username")
resp = API.get_user_events(username)
self._send_json(resp.data if not resp.error else {"error": resp.error})

elif action == "clearcache":
CACHE.clear()
self._send_json({"status": "cache vidé"})

else:
self._send_json({"error": f"action inconnue : {action}"}, 400)

else:
self._send_json({"error": "not found"}, 404)


class DashboardServer(ThreadingHTTPServer):
daemon_threads = True
allow_reuse_address = True


def lancer_dashboard(port=8080):
"""Lance le serveur dashboard."""
LOG.info(f"Dashboard : http://127.0.0.1:{port}/")
try:
server = DashboardServer(("0.0.0.0", port), DashboardHandler)
server.serve_forever()
except KeyboardInterrupt:
LOG.info("Dashboard arrêté")
except OSError as e:
LOG.error(f"Port {port} : {e}")


