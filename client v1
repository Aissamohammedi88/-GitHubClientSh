class Config:
"""Gestion de la configuration JSON."""

DEFAULTS = {
"token": "",
"username": "",
"default_format": "table",
"cache_enabled": True,
"cache_ttl": 3600,
"color_enabled": True,
"max_workers": 5,
"timeout": 15,
"user_agent": f"NexusGitHubClient/{VERSION}",
"dashboard_port": 8080,
"auto_analyze": True,
"verbose": False,
}

def __init__(self):
self.data = self._load()

def _load(self):
if CONFIG_FILE.exists():
try:
loaded = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
merged = {**self.DEFAULTS, **loaded}
return merged
except Exception as e:
LOG.warn(f"Config invalide : {e}")
return dict(self.DEFAULTS)
else:
cfg = dict(self.DEFAULTS)
self._save(cfg)
return cfg

def _save(self, data=None):
d = data if data else self.data
try:
CONFIG_FILE.write_text(
json.dumps(d, indent=2, ensure_ascii=False),
encoding="utf-8"
)
except Exception as e:
LOG.error(f"Sauvegarde config : {e}")

def get(self, key, default=None):
return self.data.get(key, default)

def set(self, key, value):
self.data[key] = value
self._save()

def save(self):
self._save()


