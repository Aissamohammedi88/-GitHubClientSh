def graphql(self, query, variables=None):
"""Requête GraphQL v4."""
if not self.token:
return APIResponse(
status=401, data=None,
error="GraphQL nécessite un token GitHub"
)

body = {"query": query}
if variables:
body["variables"] = variables

req = urllib.request.Request(
API_GRAPHQL,
data=json.dumps(body).encode("utf-8"),
headers=self._headers_graphql(),
method="POST",
)

start = time.time()
try:
with urllib.request.urlopen(req, timeout=TIMEOUT_GRAPHQL) as resp:
duration = (time.time() - start) * 1000
data = json.loads(resp.read().decode("utf-8"))

if "errors" in data:
return APIResponse(
status=200, data=data,
error=str(data["errors"][0].get("message", "Erreur GraphQL")),
duration_ms=duration,
)

return APIResponse(
status=200, data=data,
duration_ms=duration,
)
except Exception as e:
duration = (time.time() - start) * 1000
return APIResponse(status=0, data=None, error=str(e),
duration_ms=duration)

